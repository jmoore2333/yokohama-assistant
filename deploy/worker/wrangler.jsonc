{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yokohama-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",

  // **The custom domain, and the one thing to get right before deploying.**
  // `custom_domain: true` makes Cloudflare create and own the DNS record for
  // this hostname. `yokohama.moore.nyc` currently resolves to the cloudflared
  // tunnel that serves the ttyd terminal, so taking it here REPLACES that
  // route. Give ttyd its new hostname and verify it first; this is the step
  // that takes the old one away.
  "routes": [{ "pattern": "yokohama.moore.nyc", "custom_domain": true }],

  // Logs, because the failure this proxy is most likely to have — Modal
  // refusing its credentials — is invisible from the browser by design: it is
  // reported to the player as a 502 in the API's own shape and says nothing
  // about tokens.
  "observability": { "enabled": true }

  // Secrets are NOT here. `wrangler secret put MODAL_KEY` /  `MODAL_SECRET` /
  // `MODAL_ORIGIN`. A proxy token committed to a repo is a proxy token that has
  // to be rotated.
}
