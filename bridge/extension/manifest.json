{
  "manifest_version": 3,
  "name": "Yokohama BGA bridge (capture)",
  "version": "0.4.0",
  "description": "Read-only capture of your own Board Game Arena Yokohama table, delivered to the local yokohama-assistant bridge relay. Never submits anything to BGA.",

  "minimum_chrome_version": "111",

  "permissions": ["storage"],

  "host_permissions": [
    "*://*.boardgamearena.com/*",
    "http://127.0.0.1:8787/*"
  ],

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "Yokohama bridge - recording state, and the snapshot button",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.boardgamearena.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["main-world.js"]
    },
    {
      "matches": ["*://*.boardgamearena.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["bridge.js"]
    }
  ]
}
