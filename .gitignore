target/
*.swp
*.swo
.DS_Store

# Secrets for local tooling — wrangler's own convention (`.dev.vars` is what
# `wrangler dev` reads) and the Access service credential the live tests present.
# Never committed: a credential in history is a credential rotated.
.dev.vars
.dev.vars.*

# Phase-2.9 differential-harness divergence artifacts (generated repros;
# never committed - the seed/players/policy/step in each filename is the
# provenance, the state snapshot inside is the repro)
crates/yokohama-difftest/artifacts/

# Phase-3.2 arena corpus (generated training records; never committed - each
# file's path carries its provenance (rev / player count / cell / world seed /
# arrangement) and the record inside carries the rest, so the corpus is
# reproducible from the committed `examples/arena.rs --emit` invocation rather
# than from history)
crates/yokohama-core/corpus/

# Local, untracked docs — e.g. the engineer primer emailed outside the repo
# (kept on disk, deliberately not part of the tracked tree)
docs/temp/

# Per-developer agent/editor tooling. These are machine-local preferences, not
# project contracts: which plugins and MCP servers a given workstation has
# wired up, which permissions that operator has pre-approved, which editor is
# in use. Committing them would churn shared history with one machine's setup.
# The project's agent CONTRACTS live in CLAUDE.md (and AGENTS.md, which points
# at it) — those ARE tracked.
.agents/
.codex/
.vscode/
.claude/settings.local.json
.claude/skills/
skills-lock.json

# Wizard default autosaves (yokohama-game-<seed>.json in CWD) — never commit; the one that slipped in was removed 2026-08-06 (owner-cleared)
yokohama-game-*.json

# Phase-3.5b bridge captures (`bridge-relay --dir`, default ./bridge-captures).
# Never committed: these are the owner's own live Board Game Arena sessions,
# captured verbatim from a logged-in browser tab. They are input data for the
# importer, not a fixture — a fixture that needs one gets a redacted excerpt
# committed deliberately, under docs/plans/.
bridge-captures

# The Tabletop Simulator sheets and the 2017 English rulebook. Both left the
# public tip on 2026-10-23 (S4a). A contributor who obtains them places them here
# -- `docs/tools/mkcardart.py` reads the sheets from tts-assets/organized/, and
# the record's page citations are the English PDF's -- and they are never
# committed again.
tts-assets/
analysis-1/00-yokohama-rulebook.pdf

# The web client's build inputs and outputs. `node_modules` is restored by
# `npm ci`; `dist` is produced by `npm run build` and is what the server serves.
# Neither belongs in history -- the same reasoning the arena corpus row gives:
# both regenerate from a committed command.
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo

# M6.5b: the browser host's module, built by `npm run build:wasm` (two targets).
# The web glue is generated INTO a source directory so Vite bundles it and emits
# the `.wasm` as a hashed asset -- a static import from `public/` fails Rollup's
# resolution (spec §2.1, R7). The Node target's glue is what the wasm corpus
# replay loads (spec §6.3).
# Both regenerate from one committed command, the same reasoning `web/dist` gives.
web/src/local/wasm/
web/wasm-node/

# What the browser walk leaves behind. Playwright writes a trace, a screenshot
# and an error-context note for every FAILED test; both directories are
# regenerated by `npm run e2e` and neither is evidence -- a finding that matters
# gets written up, not left as a zip nobody opens.
web/test-results/
web/playwright-report/
docs/tools/__pycache__/

# M6.5b2: the help panel's screenshots are an INTERMEDIATE. `shots.spec.ts` can
# only write PNG or JPEG (Playwright has no WebP encoder), and 4.2 MB of PNG was
# 29% of a release the service worker now precaches whole -- so the generator
# writes HERE, outside `public/`, and `docs/tools/mkhelpart.py` cuts the
# committed `web/public/help/*.webp` from what it wrote. Outside `public/`
# because Vite copies that tree into `dist/` wholesale: a PNG left there would
# ship beside the WebP cut from it. Same reasoning as the two rows above, one
# step longer.
web/help-shots/

# Cycle F: the pinned-browser instrument's state (`web/scripts/pinned-browsers.mjs`,
# the orchestrator's): one persistent Chromium profile per host, its snapshots,
# its log and its trigger files. A browser profile holds cookies, so it is never
# committed; the instrument writes no cookie VALUE into its own files.
web/scripts/pinned/

# M6.5c: the Worker package's generated trees. `gen/` is the module build's
# output (`npm run build:module` or `build:module:debug`: the glue, the factory,
# the module), `assets/` the asset assembly's (`npm run build:assets`), and
# `.test-assets/` with `test/fixtures.gen.ts` and `test/corpus.gen.ts` the
# pool's pre-hook's (`scripts/test-assets.mjs`). Each regenerates from a
# committed command — the reasoning `web/dist` gives. `package-lock.json` IS
# committed.
worker/gen/
worker/assets/
worker/.test-assets/
worker/node_modules/
worker/.wrangler/
worker/test/fixtures.gen.ts
worker/test/corpus.gen.ts
