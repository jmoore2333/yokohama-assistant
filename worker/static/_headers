# worker/static/_headers — the axum host's cache policy (assets.rs's cache_control, art.rs:125), restated
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-store
/shell.bin
  Cache-Control: no-store
/art/*
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
